digraph ERD {
graph [rankdir=LR, bgcolor="white", nodesep=0.7, ranksep=1.5, pad=0.4, splines=spline, fontname="Malgun Gothic", label="PC 견적 데이터베이스 | 8 tables | 점선: 비식별관계 | 금액: 본체 부품만 합산", labelloc=t, fontsize=20];
node [shape=plain, fontname="Malgun Gothic"];
edge [style=dashed, color="#64748b", fontname="Malgun Gothic", fontsize=11, dir=both];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>users · 사용자</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="user_id_in">PK</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="user_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="display_name_in"></TD><TD ALIGN="LEFT">display_name</TD><TD PORT="display_name_out" ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_out" ALIGN="LEFT">DATETIME(6)</TD></TR></TABLE>>];
consultations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>consultations · 상담</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="consultation_id_in">PK</TD><TD ALIGN="LEFT">consultation_id</TD><TD PORT="consultation_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="user_id_in">FK</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="user_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="purpose_in"></TD><TD ALIGN="LEFT">purpose</TD><TD PORT="purpose_out" ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD PORT="requirements_in"></TD><TD ALIGN="LEFT">requirements</TD><TD PORT="requirements_out" ALIGN="LEFT">JSON</TD></TR><TR><TD PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_out" ALIGN="LEFT">DATETIME(6)</TD></TR></TABLE>>];
messages [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>messages · 대화</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="message_id_in">PK</TD><TD ALIGN="LEFT">message_id</TD><TD PORT="message_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="consultation_id_in">FK</TD><TD ALIGN="LEFT">consultation_id</TD><TD PORT="consultation_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="role_in"></TD><TD ALIGN="LEFT">role</TD><TD PORT="role_out" ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="content_in"></TD><TD ALIGN="LEFT">content</TD><TD PORT="content_out" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_out" ALIGN="LEFT">DATETIME(6)</TD></TR></TABLE>>];
parts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>parts · 부품</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="part_id_in">PK</TD><TD ALIGN="LEFT">part_id</TD><TD PORT="part_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="category_in"></TD><TD ALIGN="LEFT">category</TD><TD PORT="category_out" ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD PORT="brand_in"></TD><TD ALIGN="LEFT">brand</TD><TD PORT="brand_out" ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD PORT="name_in"></TD><TD ALIGN="LEFT">name</TD><TD PORT="name_out" ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD PORT="model_number_in"></TD><TD ALIGN="LEFT">model_number</TD><TD PORT="model_number_out" ALIGN="LEFT">VARCHAR(150) ?</TD></TR><TR><TD PORT="specs_in"></TD><TD ALIGN="LEFT">specs</TD><TD PORT="specs_out" ALIGN="LEFT">JSON</TD></TR><TR><TD PORT="source_url_in"></TD><TD ALIGN="LEFT">source_url</TD><TD PORT="source_url_out" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="verified_at_in"></TD><TD ALIGN="LEFT">verified_at</TD><TD PORT="verified_at_out" ALIGN="LEFT">DATETIME(6) ?</TD></TR><TR><TD PORT="current_price_in"></TD><TD ALIGN="LEFT">current_price</TD><TD PORT="current_price_out" ALIGN="LEFT">DECIMAL(15,2) ?</TD></TR><TR><TD PORT="currency_in"></TD><TD ALIGN="LEFT">currency</TD><TD PORT="currency_out" ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD PORT="price_source_url_in"></TD><TD ALIGN="LEFT">price_source_url</TD><TD PORT="price_source_url_out" ALIGN="LEFT">TEXT ?</TD></TR><TR><TD PORT="price_checked_at_in"></TD><TD ALIGN="LEFT">price_checked_at</TD><TD PORT="price_checked_at_out" ALIGN="LEFT">DATETIME(6) ?</TD></TR></TABLE>>];
quotes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>quotes · 견적</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="quote_id_in">PK</TD><TD ALIGN="LEFT">quote_id</TD><TD PORT="quote_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="consultation_id_in">FK</TD><TD ALIGN="LEFT">consultation_id</TD><TD PORT="consultation_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="version_in"></TD><TD ALIGN="LEFT">version</TD><TD PORT="version_out" ALIGN="LEFT">INT</TD></TR><TR><TD PORT="status_in"></TD><TD ALIGN="LEFT">status</TD><TD PORT="status_out" ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="currency_in"></TD><TD ALIGN="LEFT">currency</TD><TD PORT="currency_out" ALIGN="LEFT">CHAR(3)</TD></TR><TR><TD PORT="total_amount_in"></TD><TD ALIGN="LEFT">total_amount</TD><TD PORT="total_amount_out" ALIGN="LEFT">DECIMAL(15,2) ?</TD></TR><TR><TD PORT="created_at_in"></TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_out" ALIGN="LEFT">DATETIME(6)</TD></TR><TR><TD PORT="updated_at_in"></TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_out" ALIGN="LEFT">DATETIME(6)</TD></TR></TABLE>>];
quote_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>quote_items · 견적 항목</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="quote_item_id_in">PK</TD><TD ALIGN="LEFT">quote_item_id</TD><TD PORT="quote_item_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="quote_id_in">FK</TD><TD ALIGN="LEFT">quote_id</TD><TD PORT="quote_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="part_id_in">FK</TD><TD ALIGN="LEFT">part_id</TD><TD PORT="part_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="part_name_snapshot_in"></TD><TD ALIGN="LEFT">part_name_snapshot</TD><TD PORT="part_name_snapshot_out" ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD PORT="quantity_in"></TD><TD ALIGN="LEFT">quantity</TD><TD PORT="quantity_out" ALIGN="LEFT">INT</TD></TR><TR><TD PORT="unit_price_in"></TD><TD ALIGN="LEFT">unit_price</TD><TD PORT="unit_price_out" ALIGN="LEFT">DECIMAL(15,2) ?</TD></TR><TR><TD PORT="price_source_url_in"></TD><TD ALIGN="LEFT">price_source_url</TD><TD PORT="price_source_url_out" ALIGN="LEFT">TEXT ?</TD></TR><TR><TD PORT="price_checked_at_in"></TD><TD ALIGN="LEFT">price_checked_at</TD><TD PORT="price_checked_at_out" ALIGN="LEFT">DATETIME(6) ?</TD></TR><TR><TD PORT="configuration_in"></TD><TD ALIGN="LEFT">configuration</TD><TD PORT="configuration_out" ALIGN="LEFT">JSON</TD></TR></TABLE>>];
part_compatibility [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>part_compatibility · 공식 호환성 근거</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="compatibility_id_in">PK</TD><TD ALIGN="LEFT">compatibility_id</TD><TD PORT="compatibility_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="part_a_id_in">FK</TD><TD ALIGN="LEFT">part_a_id</TD><TD PORT="part_a_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="part_b_id_in">FK</TD><TD ALIGN="LEFT">part_b_id</TD><TD PORT="part_b_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="check_type_in"></TD><TD ALIGN="LEFT">check_type</TD><TD PORT="check_type_out" ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD PORT="support_status_in"></TD><TD ALIGN="LEFT">support_status</TD><TD PORT="support_status_out" ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="bios_scope_in"></TD><TD ALIGN="LEFT">bios_scope</TD><TD PORT="bios_scope_out" ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="min_bios_version_in"></TD><TD ALIGN="LEFT">min_bios_version</TD><TD PORT="min_bios_version_out" ALIGN="LEFT">VARCHAR(50) ?</TD></TR><TR><TD PORT="conditions_in"></TD><TD ALIGN="LEFT">conditions</TD><TD PORT="conditions_out" ALIGN="LEFT">JSON</TD></TR><TR><TD PORT="source_publisher_in"></TD><TD ALIGN="LEFT">source_publisher</TD><TD PORT="source_publisher_out" ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD PORT="source_url_in"></TD><TD ALIGN="LEFT">source_url</TD><TD PORT="source_url_out" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="source_updated_at_in"></TD><TD ALIGN="LEFT">source_updated_at</TD><TD PORT="source_updated_at_out" ALIGN="LEFT">DATETIME(6) ?</TD></TR><TR><TD PORT="verified_at_in"></TD><TD ALIGN="LEFT">verified_at</TD><TD PORT="verified_at_out" ALIGN="LEFT">DATETIME(6)</TD></TR></TABLE>>];
quote_validations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>quote_validations · 견적 검증 결과</B></TD></TR><TR><TD><B>키</B></TD><TD><B>컬럼</B></TD><TD><B>자료형</B></TD></TR><TR><TD PORT="validation_id_in">PK</TD><TD ALIGN="LEFT">validation_id</TD><TD PORT="validation_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="quote_id_in">FK</TD><TD ALIGN="LEFT">quote_id</TD><TD PORT="quote_id_out" ALIGN="LEFT">BIGINT</TD></TR><TR><TD PORT="quote_version_in"></TD><TD ALIGN="LEFT">quote_version</TD><TD PORT="quote_version_out" ALIGN="LEFT">INT</TD></TR><TR><TD PORT="item_a_id_in">FK</TD><TD ALIGN="LEFT">item_a_id</TD><TD PORT="item_a_id_out" ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD PORT="item_b_id_in">FK</TD><TD ALIGN="LEFT">item_b_id</TD><TD PORT="item_b_id_out" ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD PORT="compatibility_id_in">FK</TD><TD ALIGN="LEFT">compatibility_id</TD><TD PORT="compatibility_id_out" ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD PORT="check_type_in"></TD><TD ALIGN="LEFT">check_type</TD><TD PORT="check_type_out" ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD PORT="result_in"></TD><TD ALIGN="LEFT">result</TD><TD PORT="result_out" ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="reason_in"></TD><TD ALIGN="LEFT">reason</TD><TD PORT="reason_out" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="input_snapshot_in"></TD><TD ALIGN="LEFT">input_snapshot</TD><TD PORT="input_snapshot_out" ALIGN="LEFT">JSON</TD></TR><TR><TD PORT="evidence_snapshot_in"></TD><TD ALIGN="LEFT">evidence_snapshot</TD><TD PORT="evidence_snapshot_out" ALIGN="LEFT">JSON</TD></TR><TR><TD PORT="checked_at_in"></TD><TD ALIGN="LEFT">checked_at</TD><TD PORT="checked_at_out" ALIGN="LEFT">DATETIME(6)</TD></TR></TABLE>>];
users:user_id_out:e -> consultations:user_id_in:w [label="상담 생성", arrowtail="teetee", arrowhead="crowodot"];
consultations:consultation_id_out:e -> messages:consultation_id_in:w [label="대화 기록", arrowtail="teetee", arrowhead="crowodot"];
consultations:consultation_id_out:e -> quotes:consultation_id_in:w [label="견적 생성", arrowtail="teetee", arrowhead="crowodot"];
quotes:quote_id_out:e -> quote_items:quote_id_in:w [label="견적 구성", arrowtail="teetee", arrowhead="crowodot"];
parts:part_id_out:e -> quote_items:part_id_in:w [label="선택 부품", arrowtail="teetee", arrowhead="crowodot"];
parts:part_id_out:e -> part_compatibility:part_a_id_in:w [label="부품 A", arrowtail="teetee", arrowhead="crowodot"];
parts:part_id_out:e -> part_compatibility:part_b_id_in:w [label="부품 B", arrowtail="teetee", arrowhead="crowodot"];
quotes:quote_id_out:e -> quote_validations:quote_id_in:w [label="견적 검증", arrowtail="teetee", arrowhead="crowodot"];
quote_items:quote_item_id_out:e -> quote_validations:item_a_id_in:w [label="검증 대상 A", arrowtail="teeodot", arrowhead="crowodot"];
quote_items:quote_item_id_out:e -> quote_validations:item_b_id_in:w [label="검증 대상 B", arrowtail="teeodot", arrowhead="crowodot"];
part_compatibility:compatibility_id_out:e -> quote_validations:compatibility_id_in:w [label="참조 근거", arrowtail="teeodot", arrowhead="crowodot"];
}
