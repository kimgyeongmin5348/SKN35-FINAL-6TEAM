              ]
            },
            "description": "세부 조건. 예: {\"min_ram_gb\": 16}",
            "title": "Preferences",
            "type": "object"
          },
          "product_types": {
            "description": "찾을 상품 유형 코드. 예: laptop, monitor",
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Product Types",
            "type": "array"
          },
          "purpose": {
            "description": "사용 목적. 예: 영상 편집",
